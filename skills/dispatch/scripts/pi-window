#!/usr/bin/env bash
# Launch a pi build in a new window, or a named pane of the caller's window.
# usage: pi-window [--pane] <name> <workdir> <brief-file> [--bead ID ... --report PATH] [--] [pi-args...]
# The brief file's contents become pi's first message (with --model: pi starts idle, Bifrost is pinned,
# then a one-line pointer to the brief is sent); extra args go to pi before it
# (e.g. `-e <path>` to try an extension for this run only). pi runs under an interactive
# zsh so ~/.zshrc.local's pi() wrapper (TypeSafe key, Jev flags) applies.
set -euo pipefail
mode=window
if [ "${1:-}" = --pane ]; then mode=pane; shift; fi
[ $# -ge 3 ] || { echo "usage: pi-window [--pane] <name> <workdir> <brief-file> [--bead ID ... --report PATH] [--] [pi-args...]" >&2; exit 2; }
name=$1 dir=$2 brief=$3
shift 3
beads=() report=""
while [ $# -gt 0 ]; do
  case $1 in
    --bead|--report)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "$1 needs a value" >&2; exit 2; }
      if [ "$1" = --bead ]; then beads+=("$2"); else report=$2; fi
      shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
model=default
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case ${args[i]} in
    --model|-m) model=${args[i+1]:-default} ;;
    --model=*) model=${args[i]#--model=} ;;
  esac
done
extra=""
for a in "$@"; do
  # The launch command is single-quoted for zsh -ic, so an arg holding a quote would break out of it.
  [[ $a != *[\'\"]* ]] || { echo "pi args must not contain quotes: $a" >&2; exit 2; }
  extra+=" $(printf '%q' "$a")"
done
[[ $name =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || { echo "window name must be short kebab-case: $name" >&2; exit 2; }
[ -d "$dir" ] || { echo "no such workdir: $dir" >&2; exit 2; }
[ -s "$brief" ] || { echo "brief file missing or empty: $brief" >&2; exit 2; }
[ -n "${TMUX:-}" ] || { echo "not inside tmux" >&2; exit 2; }
if tmux list-windows -F '#W' | grep -qx "$name"; then echo "window already exists: $name" >&2; exit 1; fi
if tmux list-panes -s -F '#{pane_id} #{@build}' | awk -v name="$name" '$2 == name { found=1 } END { exit !found }'; then
  echo "pane already exists: $name" >&2; exit 1
fi
brief=$(realpath "$brief")
dir=$(realpath "$dir")
base=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || base=unknown
branch=$(git -C "$dir" branch --show-current 2>/dev/null) || branch=unknown
branch=${branch:-detached}
report=${report:-drafts/sessions/$name.md}
[[ $report = /* ]] || report="$dir/$report"
# With an explicit model, pi starts idle so Bifrost can be pinned before the first message:
# an unpinned first turn is routed by Bifrost and ignores --model (sk-k9j).
first_msg=" \"\$(<$(printf '%q' "$brief"))\""
[ "$model" = default ] || first_msg=""
launch="export FOREMAN_ACTOR=pi FOREMAN_SESSION=$name FOREMAN_TICKETS=$(printf '%q' "${beads[*]:-}"); pi --name \"$name\"$extra$first_msg; echo; echo \"[pi exited] press enter\"; read"
launch=${launch//\'/\'\\\'\'}
target=$name
if [ "$mode" = pane ]; then
  [ -n "${TMUX_PANE:-}" ] || { echo "pane mode requires TMUX_PANE" >&2; exit 2; }
  target=$(tmux split-window -d -h -t "$TMUX_PANE" -P -F '#{pane_id}' -c "$dir" "zsh -ic '$launch'")
  tmux set-option -p -t "$target" @build "$name"
  tmux select-pane -t "$target" -T "$name"
  # Equal tiles keep the coordinator readable even when it is not the first pane.
  tmux select-pane -t "$TMUX_PANE"
  tmux select-layout -t "$TMUX_PANE" tiled >/dev/null
  echo "launched pi in pane '$name' ($target) ($dir)"
else
  tmux new-window -d -n "$name" -c "$dir" "zsh -ic '$launch'"
  tmux set-option -w -t ":$name" automatic-rename off >/dev/null
  echo "launched pi in window '$name' ($dir)"
fi
pane_text() { tmux capture-pane -p -J -t "$target" 2>/dev/null || true; }
wait_for() { # wait_for <regex> <seconds>
  local i
  for ((i=0; i<$2; i++)); do pane_text | grep -Eq "$1" && return 0; sleep 1; done
  return 1
}
send_line() { tmux send-keys -t "$target" -l "$1"; sleep 0.5; tmux send-keys -t "$target" Enter; }
if [ "$model" != default ]; then
  next="answer it, run /bifrost pin, check the footer shows $model, then send: Read the brief at $brief and follow it."
  if ! wait_for 'Bifrost' 60; then
    if pane_text | grep -qi 'trust'; then echo "warning: pi shows its trust prompt; $next" >&2
    else echo "warning: pi did not start within 60 s; $next" >&2; fi
  else
    send_line "/bifrost pin"
    if wait_for 'Bifrost · pinned' 15 && pane_text | grep -qF "${model#*/}"; then
      send_line "Read the brief at $brief and follow it."
      echo "pinned $model and sent the brief"
    else
      echo "warning: could not confirm Bifrost pinned on $model; read the pane, then send: Read the brief at $brief and follow it." >&2
    fi
  fi
fi
if [ "${#beads[@]}" -gt 0 ]; then
  if ! command -v foreman >/dev/null 2>&1; then
    echo "warning: foreman not installed; continuing" >&2
  else
    sender=$(dirname "$(realpath "$0")")/../../foreman/scripts/foreman-send
    for id in "${beads[@]}"; do
      (cd "$dir"; FOREMAN_ACTOR=pi FOREMAN_SESSION="$name" bash "$sender" dispatch "$id" \
        --window "$target" --harness pi --model "$model" --workdir "$dir" \
        --branch "$branch" --base "$base" --brief "$brief" --report "$report") || \
        echo "warning: foreman adapter unavailable; continuing" >&2
    done
  fi
fi
