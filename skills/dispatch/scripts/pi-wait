#!/usr/bin/env bash
# Wait for a pi build in a window or tagged pane to print <marker>.
# usage: pi-wait [--pane] <name> <marker> [timeout-seconds]   (default timeout 3600)
# Polls the pane's whole scrollback. A line matches only if, with leading and
# trailing whitespace trimmed, it equals the marker exactly: the marker quoted inside
# the brief or the launch command never matches. Only marker lines printed after
# pi-wait starts count, so re-waiting after sending work back to a session that
# already printed its marker waits for the next one.
# A provider limit is an "Error:" line naming a usage limit, extra usage, a rate limit or 429
# (e.g. "Error: Codex error: The usage limit has been reached"): pi stops and sits idle there.
# A session can also stop and wait unseen: at pi's "Trust project folder?" prompt (BLOCKED), or
# asking a question with nothing on screen changing for PI_WAIT_IDLE seconds (default 600;
# pi's spinner and counters move while it works) (IDLE, with the last screen lines).
# exit 0 DONE (marker line), 5 LIMITED (prints the error line), 6 BLOCKED (prints the prompt),
#      7 IDLE (prints the last lines), 3 EXITED ("[pi exited] press enter" line), 4 timeout,
#      2 target gone (or ambiguous pane tag), 1 usage.
set -uo pipefail
mode=window
if [ "${1:-}" = --pane ]; then mode=pane; shift; fi
[ $# -ge 2 ] && [ $# -le 3 ] || { echo "usage: pi-wait [--pane] <name> <marker> [timeout-seconds]" >&2; exit 1; }
win=$1 marker=$2 timeout=${3:-3600} interval=${PI_WAIT_INTERVAL:-5} idle=${PI_WAIT_IDLE:-600}
[[ $timeout =~ ^[0-9]+$ ]] || { echo "timeout must be whole seconds: $timeout" >&2; exit 1; }
[ -n "$(printf '%s' "$marker" | tr -d '[:space:]')" ] || { echo "marker must not be blank" >&2; exit 1; }

target=":$win"
if [ "$mode" = pane ]; then
  target=$(bash "$(dirname "$(realpath "$0")")/pi-pane" "$win") || { echo GONE; exit 2; }
fi
exists() {
  if [ "$mode" = pane ]; then
    tmux list-panes -s -F '#{pane_id}' 2>/dev/null | grep -qxF -- "$target"
  else
    tmux list-windows -F '#W' 2>/dev/null | grep -qxF -- "$win"
  fi
}

# Prints "<marker lines> <exit lines> <limit lines> <last limit line>" over the whole scrollback.
count() {
  tmux capture-pane -p -J -S - -t "$target" 2>/dev/null | M="$marker" awk '
    { gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
    $0 == ENVIRON["M"] { d++ }
    $0 == "[pi exited] press enter" { e++ }
    /^Error:/ && tolower($0) ~ /usage limit|extra usage|rate limit|429/ { l++; last = $0 }
    END { print d + 0, e + 0, l + 0, last }'
}

# The visible screen only (no scrollback): what the session shows right now.
screen() { tmux capture-pane -p -J -t "$target" 2>/dev/null; }
# Milliseconds since the epoch (bash 5 EPOCHREALTIME), so short idle limits are exact.
now_ms() {
  local t=${EPOCHREALTIME:-}
  # macOS ships bash 3.2 without EPOCHREALTIME: fall back to whole seconds.
  if [ -z "$t" ]; then echo $(( $(date +%s) * 1000 )); return; fi
  t=${t/./}; echo "${t:0:${#t}-3}"
}

deadline=$((SECONDS + timeout))
exists || { echo "GONE"; exit 2; }
read -r base_done base_exit base_limit _ < <(count)
last_screen=$(screen | md5sum) last_change=$(now_ms)
while :; do
  exists || { echo "GONE"; exit 2; }
  read -r now_done now_exit now_limit limit_line < <(count)
  # DONE beats LIMITED beats EXITED beats BLOCKED and IDLE: a finished session is done whatever follows.
  [ "$now_done" -gt "$base_done" ] && { echo DONE; exit 0; }
  [ "$now_limit" -gt "$base_limit" ] && { echo LIMITED; echo "$limit_line"; exit 5; }
  [ "$now_exit" -gt "$base_exit" ] && { echo EXITED; exit 3; }
  shown=$(screen)
  # pi's prompt: a line that is exactly the question, with its "Trust parent folder" option
  # showing; the phrase quoted inside text the session is reading does not count.
  if printf '%s\n' "$shown" | grep -qxE '[[:space:]]*Trust project folder\?[[:space:]]*' &&
     printf '%s\n' "$shown" | grep -qE '^[[:space:]→]*Trust parent folder'; then
    echo BLOCKED; echo "Trust project folder?"; exit 6
  fi
  sum=$(printf '%s' "$shown" | md5sum)
  [ "$sum" != "$last_screen" ] && { last_screen=$sum; last_change=$(now_ms); }
  if [ $(( $(now_ms) - last_change )) -ge $((idle * 1000)) ]; then
    echo IDLE; printf '%s\n' "$shown" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g' | grep -v '^$' | grep -v '^[─━-]*$' | tail -6; exit 7
  fi
  [ "$SECONDS" -ge "$deadline" ] && { echo "TIMEOUT"; exit 4; }
  sleep "$interval"
done
